# Lawbot 개발 웹앱 설정 (운영 모델 서버를 함께 씀). 사용법: 개발 레포에서 cp .env.dev.example .env && chmod 600 .env
# 포트 번호는 직접 정해서 적기 (레포에 올리지 않음). 운영 웹앱 포트와 멀리 떨어진 값을 쓴다
# 모델 폴더·상주 모델 수는 모델 서버(운영 .env의 LAWBOT_SERVE_*)가 정한다. 웹앱은 모델 id로 고른다
# 검색 설정(리랭커·하위법령)과 프롬프트·조문 데이터는 웹앱 쪽이라 개발 레포에서 바꿔 바로 시험할 수 있다
# 모델 서버 코드(services/model-server)를 바꿔 시험할 때는 docs/operations.md "상시 운영과 개발 동시 실행" 참고

# ---- 로그인 (필수) ----
LAWBOT_USER=
LAWBOT_PW=

# ---- 개발 웹앱 ----
LAWBOT_INSTANCE=개발
LAWBOT_PORT=

# ---- 모델 서버 (운영 .env와 같은 주소·토큰) ----
LAWBOT_MODEL_SERVER=http://127.0.0.1:<모델 서버 포트>
LAWBOT_MODEL_TOKEN=

# ---- 검색·답변 (모델 id는 모델 서버의 LAWBOT_SERVE_*에 있어야 함) ----
LAWBOT_EMB_MODEL=lawbot-emb-v4
LAWBOT_RERANKER_ENABLED=1
LAWBOT_RERANK_MODEL=qwen3-reranker-4b
LAWBOT_RERANKER_CANDIDATES=10
LAWBOT_MODELS=pro
LAWBOT_PRO_MODEL=qwen3.8-27b-4bit
LAWBOT_PRO_SYSTEM=data/v4/system_v4_concise.txt

# ---- 시행령·시행규칙 첨부 (리랭커가 켜져 있어야 함) ----
LAWBOT_DECREE_ENABLED=1
LAWBOT_DECREE_TAU=0.9
LAWBOT_DECREE_K=2
LAWBOT_DECREE_MODELS=pro

# ---- v5 (노동 + 세금·보험 범위, docs/plans/v5-tax-scope.md). 켜면 첫 시작 때 조문 1,497개를 모델 서버로 임베딩 (4단계 승인 뒤) ----
# 최대 토큰은 uv run lawbot-max-seq data/v5/law_articles_v5_decree.csv --tokenizer <임베딩 모델 폴더>/tokenizer.json 출력
# LAWBOT_V4_ARTICLES=data/v5/articles_v5.csv
# LAWBOT_V4_DECREE_ARTICLES=data/v5/law_articles_v5_decree.csv
# LAWBOT_MAX_SEQ=4352
# LAWBOT_DECREE_MAX_SEQ=5120
# LAWBOT_PRO_SYSTEM=data/v5/system_v5_concise.txt        # 후보: system_v5_concise_mixed.txt ([주의] 조문 안내 추가). val로 고름

# ---- 답변 피드백 (선택). 개발 웹앱은 개발 레포의 feedback/(gitignore)에 저장 ----
# LAWBOT_FEEDBACK=1
