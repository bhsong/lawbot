# Lawbot 개발 웹앱 설정 (임베딩·리랭크 서버와 단독 생성 서버 공유). 개발 레포에서 cp .env.dev.example .env && chmod 600 .env
# 포트 번호는 직접 정해서 적기 (레포에 올리지 않음). 운영 웹앱 포트와 멀리 떨어진 값을 쓴다
# 임베딩·리랭크 폴더는 모델 서버의 LAWBOT_SERVE_*가 정한다. 생성 모델은 저장소 밖 생성 서버가 상주시킨다.
# 검색 설정(리랭커·하위법령)과 프롬프트·조문 데이터는 웹앱 쪽이라 개발 레포에서 바꿔 바로 시험할 수 있다
# 모델 서버 코드(services/model-server)를 바꿔 시험할 때는 docs/operations.md "상시 운영과 개발 동시 실행" 참고

# ---- 로그인 (필수) ----
LAWBOT_USER=
LAWBOT_PW=

# ---- 개발 웹앱 ----
LAWBOT_INSTANCE=개발
LAWBOT_PORT=

# ---- 모델 서버 (운영 .env와 같은 주소·토큰) ----
LAWBOT_MODEL_SERVER=http://127.0.0.1:<모델 서버 포트>
LAWBOT_MODEL_TOKEN=

# ---- 생성 서버 (필수, 모델 서버와 다른 전용 토큰 16자 이상) ----
LAWBOT_LLM_BASE_URL=http://127.0.0.1:<생성 서버 포트>/v1
LAWBOT_LLM_API_KEY=
# 외부 생성 API는 https 주소와 LAWBOT_LLM_ALLOW_EXTERNAL=1이 필요

# ---- 검색·답변 (검색 모델 id는 모델 서버 목록, 답변 모델 id는 생성 서버 목록에 있어야 함) ----
LAWBOT_PROFILE=v5
LAWBOT_EMB_MODEL=lawbot-emb-v6
LAWBOT_RERANKER_ENABLED=1
LAWBOT_RERANK_MODEL=qwen3-reranker-4b
LAWBOT_RERANKER_CANDIDATES=10
LAWBOT_PRO_MODEL=qwen3.8-27b-4bit

# ---- 시행령·시행규칙 첨부 (리랭커가 켜져 있어야 함) ----
LAWBOT_DECREE_ENABLED=1
LAWBOT_DECREE_TAU=0.9
LAWBOT_DECREE_K=2

# ---- v5 조문·프롬프트 ----
# 기본 data/v5를 사용합니다. 개발 데이터 사본을 쓰려면 두 경로를 함께 지정합니다.
# LAWBOT_V5_ARTICLES=data/live/v5/articles_v5.csv
# LAWBOT_V5_DECREE_ARTICLES=data/live/v5/law_articles_v5_decree.csv

# ---- 답변 피드백 (선택). 개발용 DB는 lawbot-db init으로 준비하고 LAWBOT_FEEDBACK_DIR를 비웁니다 ----
# LAWBOT_FEEDBACK=1
# LAWBOT_DB=data/db/lawbot.db
# LAWBOT_DB를 비우면 기존 JSONL을 사용합니다 (기본 feedback/, Git 제외).

# LAWBOT_CONSULT_TRACE: 개발 DB가 있으면 기본으로 상담 원문을 무기한 저장합니다. 끌 때만 0을 지정합니다.
