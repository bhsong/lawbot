<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replacement for the existing daily job. Use the same label and unload the old job before installing. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lawbot.monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>--project</string>
    <string>__ROOT__/services/source-hub</string>
    <string>--frozen</string>
    <string>--no-sync</string>
    <string>source-hub</string>
    <string>--database</string>
    <string>__COLLECTOR_DB__</string>
    <string>daily</string>
    <string>--root</string>
    <string>__ROOT__</string>
    <string>--uv</string>
    <string>__UV__</string>
    <string>--monitor-home</string>
    <string>__MONITOR_HOME__</string>
    <string>--calendar-db</string>
    <string>__CALENDAR_DB__</string>
    <string>--erp-data</string>
    <string>__ERP_DATA__</string>
    <string>--materials</string>
    <string>__MATERIALS_DB__</string>
    <string>--out</string>
    <string>__DAILY_FEED__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/monitor.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/monitor.log</string>
</dict>
</plist>
