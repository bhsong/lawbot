{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@lawbot/ui": ["../../../packages/lawbot-ui/src/index.ts"],
      "@lawbot/ui/*": ["../../../packages/lawbot-ui/src/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "@testing-library/react": ["./node_modules/@testing-library/react"]
    }
  },
  "include": ["src", "vite.config.ts", "../../../packages/lawbot-ui/src"]
}
