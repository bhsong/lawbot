# 법령 변경 수집기 비밀값. services/monitor/.env로 복사해서 채운다 (git에 올리지 않음, 루트 .gitignore의 .env)
# LAW_OC: 법제처 Open API 인증키 (collect·replay에 필요, bootstrap은 없어도 됨)
LAW_OC=
# LAW_ASSEMBLY_KEY: 열린국회정보 Open API 인증키
LAW_ASSEMBLY_KEY=
# LAW_ASSEMBLY_ENABLED=1
# DATA_GO_KR_KEY: 공공데이터포털 서비스키
DATA_GO_KR_KEY=

# 실행 데이터(data/·logs/) 위치. 비우면 services/monitor
# LAW_MONITOR_HOME=
