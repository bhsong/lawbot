# Lawbot 실행 설정 (맥 미니 32GB · v5 · Pro 27B 단독 · 리랭커 켜짐 · 시행령·시행규칙 첨부)
# 모델 서버(uv run lawbot-model-server)와 웹앱(uv run lawbot-app)이 이 파일을 함께 읽는다
# 사용법:  cp .env.example .env && chmod 600 .env → LAWBOT_USER·LAWBOT_PW, 아래 '모델 서버' 블록의 포트·주소·토큰을 채운다
# .env는 .gitignore에 들어 있어 Git에 올라가지 않습니다. 이 .env.example에는 비밀번호를 적지 마세요.
# 셸에서 export한 변수가 있으면 그 값이 이 파일보다 우선합니다. 상대 경로는 레포 최상위 기준입니다.

# ---- 로그인 (필수). 값에 공백이나 ' #'이 들어가면 작은따옴표로 감싸기: LAWBOT_PW='a b#c' ----
LAWBOT_USER=
LAWBOT_PW=

# ---- 모델 서버: 127.0.0.1에만 열고 모든 요청에 토큰. 포트 번호는 직접 정해서 적기 (레포에 올리지 않음) ----
# 토큰: openssl rand -hex 32 (웹앱과 모델 서버가 같은 값, 개발 .env도 같은 값)
LAWBOT_MODEL_SERVER_PORT=
LAWBOT_MODEL_SERVER=http://127.0.0.1:<모델 서버 포트>
LAWBOT_MODEL_TOKEN=
# 모델 서버가 제공할 모델 ('API 모델 id=폴더', 쉼표로). 웹앱은 아래 LAWBOT_*_MODEL의 id로 고른다
LAWBOT_SERVE_EMBEDDING=lawbot-emb-v5b=models/v5/emb_v5b_fp16
LAWBOT_SERVE_RERANK=qwen3-reranker-4b=models/v4/reranker_4b_mlx_4bit
LAWBOT_SERVE_CHAT=qwen3.8-27b-4bit=models/v4/qwen_27b_mlx_4bit
# chat 모델 상주 수 (LRU). 32GB에서는 27B 하나만
LAWBOT_MAX_RESIDENT=1
# 동시에 생성하는 chat 요청 수 (배치 크기). 1이 기본: 요청마다 가장 빠르고 이전과 같은 답. 2 이상은 처리량↑·요청당 지연↑
LAWBOT_MAX_CONCURRENT=1

# ---- 검색: v5 노동·소득세법 전체와 세금·4대보험 선택 조문 + v5b 임베딩 ----
LAWBOT_PROFILE=v5
LAWBOT_EMB_MODEL=lawbot-emb-v5b
# 기본 조문은 data/v5의 법률 CSV와 하위법령 포함 CSV를 사용합니다.
# 조문 인코딩 최대 토큰 (v5 기본: 법률 4352 · 하위법령 5120)
# LAWBOT_MAX_SEQ=4352
# LAWBOT_DECREE_MAX_SEQ=5120

# ---- 리랭커: 임베딩 상위 10개 → Qwen3-Reranker-4B(튜닝 없음, MLX 4비트) → 상위 3개 ----
LAWBOT_RERANKER_ENABLED=1
LAWBOT_RERANK_MODEL=qwen3-reranker-4b
LAWBOT_RERANKER_CANDIDATES=10

# ---- 시행령·시행규칙 첨부: 하위법령을 따로 임베딩 상위 10개 → 같은 리랭커 → 필터 → 최대 2개 첨부 ----
# 필터: 법률 1위와 같은 법의 하위법령은 그대로, 다른 법은 리랭커 점수 ≥ τ일 때만 (val로 고른 값)
# 리랭커가 필요하며, v5 하위법령 포함 CSV는 법률 812조문과 하위법령 1,047조문을 읽습니다.
LAWBOT_DECREE_ENABLED=1
LAWBOT_DECREE_TAU=0.9
LAWBOT_DECREE_K=2
LAWBOT_DECREE_MODELS=pro

# ---- 답변 모델: Pro = mlx-community/Qwen3.8-27B-4bit (튜닝 전), 간결형 system ----
# v5는 Pro를 사용합니다. 간결형과 전체형은 프로필의 v5 프롬프트를 선택합니다.
LAWBOT_MODELS=pro
LAWBOT_PRO_MODEL=qwen3.8-27b-4bit
# LAWBOT_PRO_SYSTEM=data/v5/system_v5_concise.txt
# LAWBOT_V5_SYSTEM=data/v5/system_v5.txt
# 생성만 다른 OpenAI 호환 API로 (선택). 질문이 이 맥 밖으로 나가므로 LAWBOT_LLM_ALLOW_EXTERNAL=1이 필요
# LAWBOT_LLM_BASE_URL=https://…/v1
# LAWBOT_LLM_API_KEY=
# LAWBOT_LLM_ALLOW_EXTERNAL=1

# ---- 답변 피드백 (선택). 켜면 답변마다 👍·깃발, 누른 답의 질문·조문·답변을 저장 (질문 원문 있음) ----
# LAWBOT_FEEDBACK=1
# SQLite는 먼저 lawbot-db init으로 만들고 LAWBOT_FEEDBACK_DIR를 비웁니다.
# LAWBOT_DB=data/db/lawbot.db
# LAWBOT_DB를 비우면 기존 JSONL 저장을 사용합니다 (기본 feedback/, Git 제외).
# LAWBOT_FEEDBACK_DIR=

# 관리자 캘린더 연결과 검토 (선택). 토큰은 캘린더 서비스의 .env와 같은 값을 사용합니다.
# LAWBOT_CALENDAR_API_URL=http://127.0.0.1:<캘린더 포트>
# LAWBOT_CALENDAR_ADMIN_TOKEN=

# 조문은 기본으로 CSV에서 읽습니다. db는 LAWBOT_DB의 프로필별 활성 릴리스를 사용합니다.
# LAWBOT_CORPUS=csv
# v5 DB 코퍼스의 검토 답변용 전용 SQLite. 미설정이면 캐시를 조회하지 않습니다.
# LAWBOT_EXACT_CACHE_DB=data/db/exact-cache.db
# 원본 P07 ZIP. 미설정이면 릴리스 자동 유지와 화면 재승인을 비활성화합니다.
# LAWBOT_EXACT_CACHE_BUNDLE=<비공개-P07-ZIP-경로>

# ---- 상시 운영 (운영 worktree의 .env). 개발 웹앱 설정은 .env.dev.example ----
# LAWBOT_INSTANCE=운영
# LAWBOT_PORT=
# 조문 자동 갱신을 쓸 때 lawbot-articles-update --init 실행 후 두 경로를 함께 지정합니다.
# LAWBOT_V5_ARTICLES=data/live/v5/articles_v5.csv
# LAWBOT_V5_DECREE_ARTICLES=data/live/v5/law_articles_v5_decree.csv
