# Lawbot 실행 설정 (맥 미니 32GB · v4 · Pro 27B 단독 · 리랭커 켜짐)
# 사용법:  cp .env.example .env && chmod 600 .env   → .env에서 LAWBOT_USER·LAWBOT_PW만 채운 뒤 uv run lawbot-app
# .env는 .gitignore에 들어 있어 Git에 올라가지 않습니다. 이 .env.example에는 비밀번호를 적지 마세요.
# 셸에서 export한 변수가 있으면 그 값이 이 파일보다 우선합니다. 상대 경로는 레포 최상위 기준입니다.

# ---- 로그인 (필수). 값에 공백이나 ' #'이 들어가면 작은따옴표로 감싸기: LAWBOT_PW='a b#c' ----
LAWBOT_USER=
LAWBOT_PW=

# ---- 검색: v4 (7개 법률 415조문) + 튜닝 Qwen3-Embedding-0.6B ----
LAWBOT_PROFILE=v4
LAWBOT_V4_ARTICLES=data/v4/articles_v4.csv
LAWBOT_V4_EMB=models/v4/emb_v4_fp16

# ---- 리랭커: 임베딩 상위 10개 → Qwen3-Reranker-4B(튜닝 없음, MLX 4비트) → 상위 3개 ----
LAWBOT_RERANKER_ENABLED=1
LAWBOT_RERANKER_MODEL_PATH=models/v4/reranker_4b_mlx_4bit
LAWBOT_RERANKER_CANDIDATES=10

# ---- 답변 모델: Pro = mlx-community/Qwen3.8-27B-4bit (튜닝 전), 간결형 system ----
# 이 맥에서는 27B만 씀. Fast는 화면에 '사용 안 함'으로만 표시되고 올리지 않음 (소형 맥 .env는 LAWBOT_MODELS=fast)
LAWBOT_MODELS=pro
LAWBOT_PRO_PATH=models/v4/qwen3.8_27b_mlx_4bit
LAWBOT_PRO_SYSTEM=data/v4/system_v4_concise.txt
LAWBOT_MAX_RESIDENT=1
LAWBOT_EARLY_STOP=0
