# Lawbot 실행 설정 (맥 미니 32GB · v4 · Pro 27B 단독 · 리랭커 켜짐 · 시행령·시행규칙 첨부)
# 모델 서버(uv run lawbot-model-server)와 웹앱(uv run lawbot-app)이 이 파일을 함께 읽는다
# 사용법:  cp .env.example .env && chmod 600 .env → LAWBOT_USER·LAWBOT_PW, 아래 '모델 서버' 블록의 포트·주소·토큰을 채운다
# .env는 .gitignore에 들어 있어 Git에 올라가지 않습니다. 이 .env.example에는 비밀번호를 적지 마세요.
# 셸에서 export한 변수가 있으면 그 값이 이 파일보다 우선합니다. 상대 경로는 레포 최상위 기준입니다.

# ---- 로그인 (필수). 값에 공백이나 ' #'이 들어가면 작은따옴표로 감싸기: LAWBOT_PW='a b#c' ----
LAWBOT_USER=
LAWBOT_PW=

# ---- 모델 서버: 127.0.0.1에만 열고 모든 요청에 토큰. 포트 번호는 직접 정해서 적기 (레포에 올리지 않음) ----
# 토큰: openssl rand -hex 32 (웹앱과 모델 서버가 같은 값, 개발 .env도 같은 값)
LAWBOT_MODEL_SERVER_PORT=
LAWBOT_MODEL_SERVER=http://127.0.0.1:<모델 서버 포트>
LAWBOT_MODEL_TOKEN=
# 모델 서버가 제공할 모델 ('API 모델 id=폴더', 쉼표로). 웹앱은 아래 LAWBOT_*_MODEL의 id로 고른다
LAWBOT_SERVE_EMBEDDING=lawbot-emb-v4=models/v4/emb_v4_fp16
LAWBOT_SERVE_RERANK=qwen3-reranker-4b=models/v4/reranker_4b_mlx_4bit
LAWBOT_SERVE_CHAT=qwen3.8-27b-4bit=models/v4/qwen3.8_27b_mlx_4bit
# chat 모델 상주 수 (LRU). 32GB에서는 27B 하나만
LAWBOT_MAX_RESIDENT=1
# 동시에 생성하는 chat 요청 수 (배치 크기). 1이 기본: 요청마다 가장 빠르고 이전과 같은 답. 2 이상은 처리량↑·요청당 지연↑
LAWBOT_MAX_CONCURRENT=1

# ---- 검색: v4 (7개 법률 415조문) + 튜닝 Qwen3-Embedding-0.6B (모델 서버의 임베딩 id) ----
LAWBOT_PROFILE=v4
LAWBOT_V4_ARTICLES=data/v4/articles_v4.csv
LAWBOT_EMB_MODEL=lawbot-emb-v4

# ---- 리랭커: 임베딩 상위 10개 → Qwen3-Reranker-4B(튜닝 없음, MLX 4비트) → 상위 3개 ----
LAWBOT_RERANKER_ENABLED=1
LAWBOT_RERANK_MODEL=qwen3-reranker-4b
LAWBOT_RERANKER_CANDIDATES=10

# ---- 시행령·시행규칙 첨부: 하위법령 397개를 따로 임베딩 상위 10개 → 같은 리랭커 → 필터 → 최대 2개를 법률 3개 뒤에 ----
# 필터: 법률 1위와 같은 법의 하위법령은 그대로, 다른 법은 리랭커 점수 ≥ τ일 때만 (val로 고른 값). 리랭커가 켜져 있어야 함
# 켜면 조문 CSV는 LAWBOT_V4_DECREE_ARTICLES(812조문)를 쓴다 (법률 415행은 위 LAWBOT_V4_ARTICLES와 같음)
# 첨부는 Pro만: Fast(4B LoRA)는 참고 조문 3개로 학습했고 첨부를 평가하지 않았다
LAWBOT_DECREE_ENABLED=1
LAWBOT_V4_DECREE_ARTICLES=data/v4/law_articles_v4_decree.csv
LAWBOT_DECREE_TAU=0.9
LAWBOT_DECREE_K=2
LAWBOT_DECREE_MODELS=pro

# ---- 답변 모델: Pro = mlx-community/Qwen3.8-27B-4bit (튜닝 전), 간결형 system ----
# 이 맥에서는 27B만 씀. Fast는 화면에 '사용 안 함'으로만 표시됨 (소형 맥 .env는 LAWBOT_MODELS=fast + LAWBOT_FAST_MODEL)
LAWBOT_MODELS=pro
LAWBOT_PRO_MODEL=qwen3.8-27b-4bit
LAWBOT_PRO_SYSTEM=data/v4/system_v4_concise.txt
# 생성만 다른 OpenAI 호환 API로 (선택). 질문이 이 맥 밖으로 나가므로 LAWBOT_LLM_ALLOW_EXTERNAL=1이 필요
# LAWBOT_LLM_BASE_URL=https://…/v1
# LAWBOT_LLM_API_KEY=
# LAWBOT_LLM_ALLOW_EXTERNAL=1

# ---- 답변 피드백 (선택). 켜면 답변마다 👍·깃발, 누른 답의 질문·조문·답변을 저장 (질문 원문 있음) ----
# 저장 폴더는 레포 밖 절대 경로를 권장 (레포 안이면 .gitignore에 걸리는 경로만 허용, 기본 feedback/)
# LAWBOT_FEEDBACK=1
# LAWBOT_FEEDBACK_DIR=

# ---- 상시 운영 (운영 worktree의 .env). 개발 웹앱 설정은 .env.dev.example ----
# LAWBOT_INSTANCE=운영
# LAWBOT_PORT=
