#!/bin/sh
set -u

model_label=com.lawbot.model-server
generation_label=local.qwen27b
agents_dir=$HOME/Library/LaunchAgents
model_plist=
generation_plist=
prod_dir=$HOME/Work/lawbot-prod
now=
stop_wait=30
unset hours deadline_override

log_result() {
    printf '%s %s: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$action" "$1"
}

fail() {
    case "${action:-}" in
        start|stop|apply) log_result "$1" >&2 ;;
        *) printf '%s\n' "$1" >&2 ;;
    esac
    exit 1
}

usage() {
    fail 'Usage: lawbot-model-hours {start|stop|apply|status} [--hours HH:MM-HH:MM] [--deadline HH:MM] [--now HH:MM[:SS]] [--stop-wait SECONDS] [--prod-dir DIR] [--model-label LABEL] [--model-plist FILE] [--generation-label LABEL] [--generation-plist FILE]'
}

read_schedule() {
    set -- "$action" --now="$now"
    if [ "${hours+x}" ]; then set -- "$@" --hours="$hours"; fi
    if [ "${deadline_override+x}" ]; then set -- "$@" --deadline="$deadline_override"; fi
    cd "$prod_dir" && exec uv run --frozen --no-sync python -m lawbot.model_hours "$@"
}

registered() {
    launchctl print "$domain/$1" >/dev/null 2>&1
}

register() {
    registered "$1" ||
        launchctl bootstrap "$domain" "$2" >/dev/null 2>&1 ||
        registered "$1"
}

status() {
    if details=$(launchctl print "$domain/$1" 2>/dev/null); then
        state=$(printf '%s\n' "$details" | awk '$1 == "state" && $2 == "=" {print $3; exit}')
        if [ "$state" = running ]; then
            printf '%s: registered, running\n' "$1"
        else
            printf '%s: registered, not running\n' "$1"
        fi
    else
        printf '%s: not registered\n' "$1"
    fi
}

stop() {
    launchctl bootout "$domain/$model_label" >/dev/null 2>&1 || :
    launchctl bootout "$domain/$generation_label" >/dev/null 2>&1 || :
    attempt=1
    while :; do
        pending=
        if registered "$model_label"; then pending=$model_label; fi
        if registered "$generation_label"; then pending="${pending:+$pending, }$generation_label"; fi
        if [ -z "$pending" ]; then
            launchctl print "$domain" >/dev/null 2>&1 || fail 'Model server bootout failed.'
            log_result 'Model servers unregistered.'
            return
        fi
        [ "$attempt" -lt "$stop_wait" ] || fail "Model server bootout failed: $pending."
        sleep 1
        attempt=$((attempt + 1))
    done
}

within_readiness_budget() {
    [ "$(date +%s)" -lt "$cutoff" ]
}

probe() {
    # macOS /bin/sh gives the background job its own process group, even without a tty.
    set -m
    (cd "$prod_dir" && exec uv run --frozen --no-sync python -m lawbot.check_deploy) >/dev/null 2>&1 &
    probe_pid=$!
    set +m
    while [ "$interrupted" -eq 0 ] && within_readiness_budget; do
        if ! kill -0 "$probe_pid" 2>/dev/null; then
            wait "$probe_pid" 2>/dev/null
            return $?
        fi
        sleep 1
    done
    if kill -TERM -- "-$probe_pid" 2>/dev/null; then
        sleep 1
        kill -KILL -- "-$probe_pid" 2>/dev/null
    fi
    wait "$probe_pid" 2>/dev/null
    return 1
} 2>/dev/null

start() {
    cutoff=$(( started_at + budget ))
    interrupted=0
    trap 'interrupted=1' HUP INT TERM
    result=0
    register "$model_label" "$model_plist" || result=1
    register "$generation_label" "$generation_plist" || result=1
    [ "$result" -eq 0 ] || fail 'Model server bootstrap failed.'
    ready=0
    while [ "$interrupted" -eq 0 ] && within_readiness_budget; do
        if probe && [ "$interrupted" -eq 0 ]; then
            ready=1
            break
        fi
        [ "$repeat" -eq 1 ] && [ "$interrupted" -eq 0 ] || break
        sleep 1
    done
    [ "$interrupted" -eq 0 ] || fail 'Model readiness check interrupted.'
    if [ "$ready" -eq 1 ]; then
        log_result 'Model servers ready.'
        return 0
    fi
    fail "Model servers not ready${deadline:+ (deadline $deadline)}."
}

[ "$#" -gt 0 ] || usage
action=$1
shift
while [ "$#" -gt 0 ]; do
    [ "$#" -ge 2 ] || usage
    case "$1" in
        --hours) hours=$2 ;;
        --deadline) deadline_override=$2 ;;
        --now) now=$2 ;;
        --stop-wait)
            case "$2" in ''|*[!0-9]*) usage ;; esac
            [ "$2" -ge 0 ] 2>/dev/null || usage
            stop_wait=$2 ;;
        --prod-dir) prod_dir=$2 ;;
        --model-label) model_label=$2 ;;
        --model-plist) model_plist=$2 ;;
        --generation-label) generation_label=$2 ;;
        --generation-plist) generation_plist=$2 ;;
        *) usage ;;
    esac
    shift 2
done

operation=$action
case "$action" in
    apply|start)
        clock=$(date '+%s %H:%M:%S') || fail 'Cannot read the local time.'
        started_at=${clock%% *}
        now=${now:-${clock#* }}
        schedule=$(read_schedule 2>/dev/null) || fail "${schedule:-Cannot resolve the model server schedule.}"
        read -r operation budget repeat deadline <<EOF
$schedule
EOF
        ;;
esac

case "$operation" in start|stop|status) ;; *) usage ;; esac
domain=gui/$(id -u)
launchctl print "$domain" >/dev/null 2>&1 || fail 'Cannot access the launchd GUI domain.'
if [ "$action" = apply ]; then
    case "$operation" in
        start) if registered "$model_label" && registered "$generation_label"; then exit 0; fi ;;
        stop) if ! registered "$model_label" && ! registered "$generation_label"; then exit 0; fi ;;
    esac
fi
model_plist=${model_plist:-$agents_dir/$model_label.plist}
generation_plist=${generation_plist:-$agents_dir/$generation_label.plist}
case "$operation" in
    start) start ;;
    stop) stop ;;
    status)
        status "$model_label"
        status "$generation_label" ;;
esac
